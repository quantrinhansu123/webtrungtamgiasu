{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{giasubinhminh.com/**,hts-cache/**}"
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/api/cms" },
    { "source": "/admin/", "destination": "/api/cms" },
    { "source": "/api/(.*)", "destination": "/api/cms" }
  ]
}
